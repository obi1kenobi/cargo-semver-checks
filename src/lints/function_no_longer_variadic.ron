SemverQuery(
    id: "function_no_longer_variadic",
    human_readable_name: "pub function is no longer variadic",
    description: "A public function is no longer variadic.",
    required_update: Major,
    lint_level: Deny,
    reference_link: Some(
        "https://doc.rust-lang.org/reference/items/functions.html#c-variadic-functions",
    ),
    query: r#"
    {
        CrateDiff {
            baseline {
                item {
                    ... on Function {
                        visibility_limit @filter(op: "=", value: ["$public"])
                        c_variadic @filter(op: "=", value: ["$true"])

                        importable_path {
                            path @output @tag
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        abi_: abi {
                            raw_name @output
                        }

                        parameter @fold {
                            name @output(name: "parameter_names")
                        }
                    }
                }
            }
            current {
                item {
                    ... on Function {
                        visibility_limit @filter(op: "=", value: ["$public"])
                        c_variadic @filter(op: "!=", value: ["$true"])

                        importable_path {
                            path @filter(op: "=", value: ["%path"])
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        span_: span @optional {
                            filename @output
                            begin_line @output
                            end_line @output
                        }
                    }
                }
            }
        }
    }"#,
    arguments: {
        "public": "public",
        "true": true,
    },
    error_message: r#"A public function is no longer variadic.
Downstream code relying on its previous signature may no longer compile."#,
    per_result_error_template: Some(
        r#"{{join "::" path}} is no longer variadic in {{span_filename}}:{{span_begin_line}}"#,
    ),
    witness: (
        hint_template: r#"let _: unsafe extern "{{abi_raw_name}}" fn(
{{#each parameter_names}}    _,
{{/each}}    ...
) -> _ = {{join "::" path}};
"#,
    ),
)
