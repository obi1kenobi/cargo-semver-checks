SemverQuery(
    id: "inherent_method_const_generic_reordered",
    human_readable_name: "inherent method const generics were reordered",
    description: "An inherent method's signature now requires a generic type in the prior spot of a const generic.",
    required_update: Major,
    lint_level: Deny,
    reference_link: Some("https://doc.rust-lang.org/reference/items/generics.html"),
    query: r#"
    {
        CrateDiff {
            baseline {
                item {
                    ... on ImplOwner {
                        visibility_limit @filter(op: "=", value: ["$public"])

                        importable_path {
                            path @tag @output
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        # A method removed from `Reader<u8>` and a different method on `Reader<u16>`
                        # can look like one method whose type and const parameters exchanged positions.
                        # TODO: Include generic owners once we can match impl targets across releases.
                        generic_parameter @fold
                                          @transform(op: "count")
                                          @filter(op: "=", value: ["$zero"])

                        inherent_impl {
                            method {
                                method_visibility: visibility_limit @filter(op: "=", value: ["$public"]) @output
                                method_name: name @output @tag
                                public_api_eligible @filter(op: "=", value: ["$true"])

                                # The generic-count lints handle changes in the number of explicit
                                # type or const arguments. An argument written as `impl Trait`
                                # introduces a synthetic type parameter that callers cannot supply.
                                generic_parameter @fold
                                                  @transform(op: "count")
                                                  @tag(name: "required_const_count")
                                                  @output(name: "required_const_count") {
                                    ... on GenericConstParameter {
                                        name
                                    }
                                }
                                generic_parameter @fold
                                                  @transform(op: "count")
                                                  @tag(name: "required_type_count")
                                                  @output(name: "required_type_count") {
                                    ... on GenericTypeParameter {
                                        synthetic @filter(op: "!=", value: ["$true"])
                                        name
                                    }
                                }

                                generic_parameter {
                                    ... on GenericConstParameter {
                                        const_name: name @output
                                        position @tag @output
                                    }
                                }

                                span_: span @optional {
                                    filename @output
                                    begin_line @output
                                    end_line @output
                                }
                            }
                        }
                    }
                }
            }
            current {
                # Several traits may provide the new parameter order. Report the old position
                # once and point to each matching declaration.
                item @fold @transform(op: "count") @filter(op: ">", value: ["$zero"]) {
                    ... on ImplOwner {
                        visibility_limit @filter(op: "=", value: ["$public"])

                        importable_path {
                            path @filter(op: "=", value: ["%path"])
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        # A type that gains a generic parameter can gain a same-named method
                        # that applies only to a new instantiation.
                        generic_parameter @fold
                                          @transform(op: "count")
                                          @filter(op: "=", value: ["$zero"])

                        # A trait may provide the function after its inherent declaration is removed.
                        # TODO: Distinguish a trait implemented for `Owner` from one implemented
                        # for `&Owner`. Only the former supplies the associated function on `Owner`.
                        impl {
                            implemented_trait @fold
                                              @transform(op: "count")
                                              @tag(name: "candidate_trait_count")

                            method {
                                visibility_limit @filter(op: "one_of", value: ["$public_or_default"])
                                name @filter(op: "=", value: ["%method_name"])
                                public_api_eligible @filter(op: "=", value: ["$true"])

                                generic_parameter @fold
                                                  @transform(op: "count")
                                                  @filter(op: "=", value: ["%required_const_count"]) {
                                    ... on GenericConstParameter {
                                        name
                                    }
                                }
                                generic_parameter @fold
                                                  @transform(op: "count")
                                                  @filter(op: "=", value: ["%required_type_count"]) {
                                    ... on GenericTypeParameter {
                                        synthetic @filter(op: "!=", value: ["$true"])
                                        name
                                    }
                                }

                                generic_parameter {
                                    ... on GenericTypeParameter {
                                        type_name: name @output
                                        position @filter(op: "=", value: ["%position"])
                                    }
                                }

                                current_span_: span @optional {
                                    filename @output
                                    begin_line @output
                                    end_line @output
                                }
                            }
                        }

                        # A public inherent function shadows every trait function with the same name
                        # in `Owner::method()`, even when the inherent function is doc-hidden.
                        # An inherent candidate has zero implemented traits, a trait candidate one.
                        inherent_impl @fold @transform(op: "count") @filter(op: "=", value: ["$zero"]) {
                            implemented_trait @fold
                                              @transform(op: "count")
                                              @filter(op: "<", value: ["%candidate_trait_count"])

                            method {
                                visibility_limit @filter(op: "=", value: ["$public"])
                                name @filter(op: "=", value: ["%method_name"])
                            }
                        }

                        # If a trait supplies the function, another trait can still accept the old
                        # argument kind at this position, even if its method is doc-hidden.
                        # An inherent candidate takes precedence over those trait functions.
                        impl @fold @transform(op: "count") @filter(op: "=", value: ["$zero"]) {
                            implemented_trait @fold
                                              @transform(op: "count")
                                              @filter(op: "=", value: ["%candidate_trait_count"])

                            method {
                                visibility_limit @filter(op: "one_of", value: ["$public_or_default"])
                                name @filter(op: "=", value: ["%method_name"])

                                generic_parameter {
                                    ... on GenericConstParameter {
                                        position @filter(op: "=", value: ["%position"])
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }"#,
    arguments: {
        "public": "public",
        "public_or_default": ["public", "default"],
        "true": true,
        "zero": 0,
    },
    error_message: "An inherent method's signature now requires a generic type parameter where a const generic previously stood. Uses of this method that supplied that const generic will be broken since a generic type is now required instead.",
    per_result_error_template: Some(r#"method {{join "::" path}}::{{method_name}} used to expect const {{const_name}} in the place of {{#each type_name}}{{#unless @first}} or {{/unless}}type {{this}}{{#if (lookup ../current_span_filename @index)}} in {{lookup ../current_span_filename @index}}:{{lookup ../current_span_begin_line @index}}{{/if}}{{/each}}"#),
    witness: None,
)
