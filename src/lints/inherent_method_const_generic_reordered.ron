SemverQuery(
    id: "inherent_method_const_generic_reordered",
    human_readable_name: "inherent method const generics were reordered",
    description: "An inherent method's signature now requires a generic type in the prior spot of a const generic.",
    required_update: Major,
    lint_level: Deny,
    reference_link: Some("https://doc.rust-lang.org/reference/items/generics.html"),
    query: r#"
    {
        CrateDiff {
            baseline {
                item {
                    ... on ImplOwner {
                        visibility_limit @filter(op: "=", value: ["$public"])

                        importable_path {
                            path @tag @output
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        inherent_impl {
                            method {
                                method_visibility: visibility_limit @filter(op: "=", value: ["$public"]) @output
                                method_name: name @output @tag
                                public_api_eligible @filter(op: "=", value: ["$true"])

                                # Count the type and const parameters that can be supplied in a turbofish.
                                # Changes to these counts belong to the generic-count lints.
                                # An argument-position `impl Trait` adds a synthetic type parameter
                                # that cannot be supplied this way, so exclude it from the count.
                                generic_parameter @fold
                                                  @transform(op: "count")
                                                  @tag(name: "required_const_count")
                                                  @output(name: "required_const_count") {
                                    ... on GenericConstParameter {
                                        name
                                    }
                                }
                                generic_parameter @fold
                                                  @transform(op: "count")
                                                  @tag(name: "required_type_count")
                                                  @output(name: "required_type_count") {
                                    ... on GenericTypeParameter {
                                        synthetic @filter(op: "!=", value: ["$true"])
                                        name
                                    }
                                }

                                generic_parameter {
                                    ... on GenericConstParameter {
                                        const_name: name @output
                                        position @tag @output
                                    }
                                }

                                span_: span @optional {
                                    filename @output
                                    begin_line @output
                                    end_line @output
                                }
                            }
                        }
                    }
                }
            }
            current {
                # `Reader<bool>::get` and `Reader<u8>::get` may accept different generic parameter orders.
                # We cannot match impl targets across versions, so comparing them by name
                # can report a reorder even when the API is unchanged.
                #
                # For each old const parameter, find a same-named public API function
                # with the same explicit type- and const-param counts and a type at that position.
                # Call this function the candidate. It may be inherent or provided by a trait;
                # the owner may be generic or nongeneric.
                # Apply these four exclusions to functions with the same name:
                # 1. Reject if a public inherent function retains a const at this position;
                #    for a trait candidate, also consider trait functions.
                # 2. On generic owners, reject if any trait function retains a const here,
                #    even for an inherent candidate.
                # 3. On generic owners, reject if any inherent function is outside public API
                #    or has different explicit parameter counts.
                # 4. Reject a trait candidate if any public inherent function has this name,
                #    regardless of its parameter order or counts.
                #
                # Checks 1 and 4 account for Rust's lookup rules.
                # Checks 2 and 3 add conservative exclusions because impl targets cannot be matched.
                # To avoid false positives, all four may suppress real reorderings
                # even when another function's parameters, visibility, or impl target prevent the old call.
                #
                # TODO: Match impl targets to detect changes to individual impls.
                #
                # Fold surviving candidates to report each old parameter once at the old method's span,
                # without attributing the change to a particular current impl.
                item @fold @transform(op: "count") @filter(op: ">", value: ["$zero"]) {
                    ... on ImplOwner {
                        visibility_limit @filter(op: "=", value: ["$public"])

                        importable_path {
                            path @filter(op: "=", value: ["%path"])
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        # The ambiguity checks below depend on whether the owner is generic.
                        # `impl Reader<bool>` declares no generic parameters, but `Reader<T>` is generic.
                        generic_parameter @fold
                                          @transform(op: "count")
                                          @tag(name: "owner_generic_count")

                        # Include trait functions that may be called after the inherent function disappears.
                        impl {
                            # Distinguish inherent candidates (zero traits) from trait candidates (one).
                            implemented_trait @fold
                                              @transform(op: "count")
                                              @tag(name: "candidate_trait_count")

                            method {
                                visibility_limit @filter(op: "one_of", value: ["$public_or_default"])
                                name @filter(op: "=", value: ["%method_name"])
                                public_api_eligible @filter(op: "=", value: ["$true"])

                                generic_parameter @fold
                                                  @transform(op: "count")
                                                  @filter(op: "=", value: ["%required_const_count"]) {
                                    ... on GenericConstParameter {
                                        name
                                    }
                                }
                                generic_parameter @fold
                                                  @transform(op: "count")
                                                  @filter(op: "=", value: ["%required_type_count"]) {
                                    ... on GenericTypeParameter {
                                        synthetic @filter(op: "!=", value: ["$true"])
                                        name
                                    }
                                }

                                generic_parameter {
                                    ... on GenericTypeParameter {
                                        position @filter(op: "=", value: ["%position"])
                                    }
                                }
                            }
                        }

                        # 1. Reject if a public inherent function retains a const at this position;
                        #    for a trait candidate, also consider trait functions.
                        #
                        # Rust gives an applicable public inherent function precedence over traits
                        # in `Owner::method::<...>()` calls. An unchanged trait function cannot
                        # preserve a call to that inherent function.
                        # Public functions remain callable when doc-hidden, including trait implementations.
                        impl @fold @transform(op: "count") @filter(op: "=", value: ["$zero"]) {
                            implemented_trait @fold
                                              @transform(op: "count")
                                              @filter(op: "<=", value: ["%candidate_trait_count"])

                            method {
                                visibility_limit @filter(op: "one_of", value: ["$public_or_default"])
                                name @filter(op: "=", value: ["%method_name"])

                                generic_parameter {
                                    ... on GenericConstParameter {
                                        position @filter(op: "=", value: ["%position"])
                                    }
                                }
                            }
                        }

                        # 2. On generic owners, reject if any trait function retains a const here,
                        #    even for an inherent candidate.
                        #
                        # `Reader<bool>::get` may move to a trait with the old parameter order,
                        # while an unchanged inherent `Reader<u8>::get` has the new order.
                        # The trait may preserve calls on `Reader<bool>` despite the inherent candidate.
                        # Include inaccessible and doc-hidden traits too, accepting missed changes.
                        impl @fold @transform(op: "count") @filter(op: "=", value: ["$zero"]) {
                            # A trait impl has count one: admit it only for an owner
                            # with at least one generic parameter, and exclude inherent impls.
                            implemented_trait @fold
                                              @transform(op: "count")
                                              @filter(op: ">", value: ["$zero"])
                                              @filter(op: "<=", value: ["%owner_generic_count"])

                            method {
                                name @filter(op: "=", value: ["%method_name"])

                                generic_parameter {
                                    ... on GenericConstParameter {
                                        position @filter(op: "=", value: ["%position"])
                                    }
                                }
                            }
                        }

                        # 3. On generic owners, reject if any inherent function is outside public API
                        #    or has different explicit parameter counts.
                        #
                        # If `Reader<bool>::get` becomes private, doc-hidden, or changes its counts,
                        # an unchanged `Reader<u8>::get` must not be treated as its reordered replacement.
                        # Exclude these cases even when the first function also has the new order.
                        # A nongeneric owner has no distinct type arguments to confuse.
                        inherent_impl @fold
                                      @transform(op: "count")
                                      @filter(op: "=", value: ["$zero"]) {
                            # Inherent impls have zero traits, so this check applies only
                            # when the owner has at least one generic parameter.
                            implemented_trait @fold
                                              @transform(op: "count")
                                              @filter(op: "<", value: ["%owner_generic_count"])

                            # The two folds find an impl with this name but no matching public API function.
                            # Ignore impl blocks that contain only unrelated functions.
                            method @fold
                                   @transform(op: "count")
                                   @filter(op: ">", value: ["$zero"]) {
                                name @filter(op: "=", value: ["%method_name"])
                            }
                            method @fold
                                   @transform(op: "count")
                                   @filter(op: "=", value: ["$zero"]) {
                                visibility_limit @filter(op: "=", value: ["$public"])
                                name @filter(op: "=", value: ["%method_name"])
                                public_api_eligible @filter(op: "=", value: ["$true"])

                                generic_parameter @fold
                                                  @transform(op: "count")
                                                  @filter(op: "=", value: ["%required_const_count"]) {
                                    ... on GenericConstParameter {
                                        name
                                    }
                                }
                                generic_parameter @fold
                                                  @transform(op: "count")
                                                  @filter(op: "=", value: ["%required_type_count"]) {
                                    ... on GenericTypeParameter {
                                        synthetic @filter(op: "!=", value: ["$true"])
                                        name
                                    }
                                }
                            }
                        }

                        # 4. Reject a trait candidate if any public inherent function has this name,
                        #    regardless of its parameter order or counts.
                        #
                        # Rust gives an applicable public inherent function precedence over traits,
                        # regardless of its parameter order or doc-hidden status.
                        # Private inherent functions do not block trait fallback for downstream callers.
                        # For generic owners, we conservatively assume the inherent function could apply.
                        inherent_impl @fold
                                      @transform(op: "count")
                                      @filter(op: "=", value: ["$zero"]) {
                            # Zero is less than the candidate's count only for a trait candidate.
                            implemented_trait @fold
                                              @transform(op: "count")
                                              @filter(op: "<", value: ["%candidate_trait_count"])

                            method {
                                visibility_limit @filter(op: "=", value: ["$public"])
                                name @filter(op: "=", value: ["%method_name"])
                            }
                        }
                    }
                }
            }
        }
    }"#,
    arguments: {
        "public": "public",
        "public_or_default": ["public", "default"],
        "true": true,
        "zero": 0,
    },
    error_message: "An inherent method no longer accepts a const argument at a previous generic parameter position. Calls supplying the old generic arguments may no longer compile.",
    per_result_error_template: Some("method {{join \"::\" path}}::{{method_name}} no longer accepts a const argument in the position of {{const_name}}; previously in {{span_filename}}:{{span_begin_line}}"),
    witness: None,
)
