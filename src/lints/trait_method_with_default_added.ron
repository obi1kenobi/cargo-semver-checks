SemverQuery(
    id: "trait_method_with_default_added",
    human_readable_name: "non-sealed trait added method with default implementation",
    description: "A non-sealed public trait added a new method with a default implementation.",
    required_update: Minor,
    lint_level: Allow,
    reference_link: Some("https://doc.rust-lang.org/cargo/reference/semver.html#trait-new-default-item"),
    query: r#"
    {
        CrateDiff {
            current {
                item {
                    ... on Trait {
                        visibility_limit @filter(op: "=", value: ["$public"])

                        importable_path {
                            path @output @tag
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        method {
                            method_name: name @output @tag
                            # Methods without a default implementation are reported by `trait_method_added`.
                            has_body @filter(op: "=", value: ["$true"])
                            public_api_eligible @filter(op: "=", value: ["$true"])

                            span_: span @optional {
                                filename @output
                                begin_line @output
                                end_line @output
                            }
                        }
                    }
                }
            }
            baseline {
                item {
                    ... on Trait {
                        visibility_limit @filter(op: "=", value: ["$public"]) @output
                        # If the baseline trait was sealed, `sealed_trait_method_added`
                        # reports the new method instead.
                        public_api_sealed @filter(op: "!=", value: ["$true"])
                        # This lint doesn't check dyn-compatibility: if the new method makes the trait
                        # no longer dyn-compatible, `trait_no_longer_dyn_compatible` reports that too.

                        importable_path {
                            path @filter(op: "=", value: ["%path"])
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        method @fold @transform(op: "count") @filter(op: "=", value: ["$zero"]) {
                            name @filter(op: "=", value: ["%method_name"])
                        }
                    }
                }
            }
        }
    }"#,
    arguments: {
        "public": "public",
        "true": true,
        "zero": 0,
    },
    error_message: "A non-sealed public trait added a new method with a default implementation.",
    per_result_error_template: Some("{{join \"::\" path}}::{{method_name}} in file {{span_filename}}:{{span_begin_line}}"),
)
