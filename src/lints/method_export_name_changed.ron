SemverQuery(
    id: "method_export_name_changed",
    human_readable_name: "method's export name has changed or been removed",
    description: "A public inherent method's export name assigned via #[no_mangle] or #[export_name = \"name\"] has changed or been removed.",
    required_update: Major,
    lint_level: Deny,
    reference_link: Some("https://doc.rust-lang.org/reference/abi.html#the-no_mangle-attribute"),
    query: r#"
    {
        CrateDiff {
            baseline {
                item {
                    ... on ImplOwner {
                        visibility_limit @filter(op: "=", value: ["$public"])

                        importable_path {
                            path @tag @output
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        # The adapter cannot distinguish `impl Reader<u8>` from `impl Reader<u16>`.
                        # Removing a method on one while a same-named method on the other survives
                        # can look like a change to the removed method's export name.
                        # TODO: Include generic owners once we can match impl targets.
                        generic_parameter @fold
                                          @transform(op: "count")
                                          @filter(op: "=", value: ["$zero"])

                        inherent_impl {
                            method {
                                visibility_limit @filter(op: "=", value: ["$public"])
                                public_api_eligible @filter(op: "=", value: ["$true"])
                                export_name @output  @filter(op: "is_not_null") @tag
                                method_name: name @tag @output
                            }
                        }
                    }
                }
            }
            current {
                item {
                    ... on ImplOwner {
                        visibility_limit @filter(op: "=", value: ["$public"])

                        importable_path {
                            path @filter(op: "=", value: ["%path"])
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        # A current method could exist only on a new parameterization of the owner.
                        generic_parameter @fold
                                          @transform(op: "count")
                                          @filter(op: "=", value: ["$zero"])

                        inherent_impl {
                            method {
                                visibility_limit @filter(op: "=", value: ["$public"])
                                name @filter(op: "=", value: ["%method_name"])
                                public_api_eligible @filter(op: "=", value: ["$true"])

                                new_export_name: export_name
                                    @filter(op: "!=", value: ["%export_name"])
                                    @output

                                span_: span @optional {
                                    filename @output
                                    begin_line @output
                                    end_line @output
                                }
                            }
                        }
                    }
                }
            }
        }
    }"#,
    arguments: {
        "public": "public",
        "true": true,
        "zero": 0,
    },
    error_message: "A public inherent method's export name changed or was removed. Downstream code that uses the old symbol may fail to link or call a different function.",
    per_result_error_template: Some("{{join \"::\" path}}::{{method_name}} {{#if new_export_name}}changed its export name from {{export_name}} to {{new_export_name}}{{else}}no longer exports symbol {{export_name}}{{/if}} in {{span_filename}}:{{span_begin_line}}"),
    witness: None,
)
