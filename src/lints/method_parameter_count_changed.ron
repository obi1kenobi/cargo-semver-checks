SemverQuery(
    id: "method_parameter_count_changed",
    human_readable_name: "pub method parameter count changed",
    description: "Parameter count of a method has changed.",
    required_update: Major,
    lint_level: Deny,
    reference_link: Some("https://doc.rust-lang.org/cargo/reference/semver.html#fn-change-arity"),
    query: r#"
    {
        CrateDiff {
            baseline {
                item {
                    ... on ImplOwner {
                        visibility_limit @filter(op: "=", value: ["$public"]) @output

                        importable_path {
                            path @output @tag
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        # The adapter cannot distinguish `impl Reader<u8>` from `impl Reader<u16>`.
                        # If `Reader<u8>::read` disappears while `Reader<u16>::read` keeps a different
                        # parameter count, matching by name would report a change to the removed method.
                        # TODO: Include generic owners once we can match impl targets.
                        generic_parameter @fold
                                          @transform(op: "count")
                                          @filter(op: "=", value: ["$zero"])

                        inherent_impl {
                            method {
                                method_visibility: visibility_limit @filter(op: "=", value: ["$public"]) @output
                                method_name: name @output @tag
                                public_api_eligible @filter(op: "=", value: ["$true"])

                                receiver @fold @transform(op: "count") @tag(name: "has_receiver") @output(name: "has_receiver")

                                old_parameter_: parameter @fold @transform(op: "count") @output @tag(name: "parameters") {
                                    name @filter(op: "!=", value: ["$self"])
                                }

                                span_: span @optional {
                                    filename @output
                                    begin_line @output
                                    end_line @output
                                }
                            }
                        }
                    }
                }
            }
            current {
                item {
                    ... on ImplOwner {
                        visibility_limit @filter(op: "=", value: ["$public"])
                        name @output
                        owner_crate_id: crate_id @tag

                        importable_path {
                            path @filter(op: "=", value: ["%path"])
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        # The current owner must also be nongeneric. A current method could apply
                        # only to an instantiation that did not have the old method.
                        generic_parameter @fold
                                          @transform(op: "count")
                                          @filter(op: "=", value: ["$zero"])

                        # A same-named trait method can still accept the old number of arguments.
                        #
                        # We use "impl" instead of "inherent_impl" here because moving
                        # an inherently-implemented method to a trait is not necessarily
                        # a breaking change, so we don't want to report it.
                        impl @fold @transform(op: "count") @filter(op: "=", value: ["$zero"]) {
                            method {
                                visibility_limit @filter(op: "one_of", value: ["$public_or_default"])
                                name @filter(op: "=", value: ["%method_name"])
                                public_api_eligible @filter(op: "=", value: ["$true"])

                                receiver @fold @transform(op: "count") @filter(op: "=", value: ["%has_receiver"])

                                parameter @fold @transform(op: "count") @filter(op: "=", value: ["%parameters"]) {
                                    name @filter(op: "!=", value: ["$self"])
                                }
                            }

                            # Exclude a private trait when its declaration is available.
                            # A glob import can bring a `pub` trait into scope through `pub use Trait as _`,
                            # which the adapter omits from importable paths. Even without a named public API path,
                            # a method on that trait could still accept the old number of arguments.
                            implemented_trait @optional {
                                trait @optional {
                                    visibility_limit @filter(op: "=", value: ["$public"])
                                }
                            }
                        }

                        # At least one same-named method must agree with the old method on whether it takes a receiver.
                        # Otherwise, removal or a receiver change alone could look like a change in arity.
                        impl @fold @transform(op: "count") @filter(op: ">", value: ["$zero"]) {
                            method {
                                visibility_limit @filter(op: "one_of", value: ["$public_or_default"])
                                name @filter(op: "=", value: ["%method_name"])
                                public_api_eligible @filter(op: "=", value: ["$true"])

                                receiver @fold
                                         @transform(op: "count")
                                         @filter(op: "=", value: ["%has_receiver"])
                                         @output(name: "found_receiver")

                                # Collect the parameter counts and spans of the methods we can cite.
                                current_parameter_: parameter @fold @transform(op: "count") @output {
                                    name @filter(op: "!=", value: ["$self"])
                                }

                                non_matching_span_: span @optional {
                                    filename @output
                                    begin_line @output
                                    end_line @output
                                }
                            }

                            # Either the trait is defined in another crate (where we assume it's public API),
                            # or it has a public API path in this crate.
                            implemented_trait @fold
                                              @transform(op: "count")
                                              @filter(op: "=", value: ["$zero"]) {
                                trait {
                                    crate_id @filter(op: "=", value: ["%owner_crate_id"])
                                    importable_path @fold
                                                    @transform(op: "count")
                                                    @filter(op: "=", value: ["$zero"]) {
                                        public_api @filter(op: "=", value: ["$true"])
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }"#,
    arguments: {
        "public": "public",
        "public_or_default": ["public", "default"],
        "self": "self",
        "true": true,
        "zero": 0,
    },
    error_message: "A publicly-visible method now takes a different number of parameters, not counting the receiver (self) parameter.",
    per_result_error_template: Some(r#"{{join "::" path}}::{{method_name}} takes {{old_parameter_count}} parameters in {{span_filename}}:{{span_begin_line}}, but now takes {{unpack_if_singleton current_parameter_count}} parameters in {{multiple_spans non_matching_span_filename non_matching_span_begin_line}}"#),
)
