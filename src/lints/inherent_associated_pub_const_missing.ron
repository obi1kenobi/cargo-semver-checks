SemverQuery(
    id: "inherent_associated_pub_const_missing",
    human_readable_name: "inherent impl's associated pub const removed",
    description: "An inherent impl's associated public const removed or renamed",
    required_update: Major,
    lint_level: Deny,
    reference_link: Some("https://doc.rust-lang.org/cargo/reference/semver.html#item-remove"),
    query: r#"
    {
        CrateDiff {
            baseline {
                item {
                    ... on ImplOwner {
                        visibility_limit @filter(op: "=", value: ["$public"]) @output

                        importable_path {
                            path @output @tag
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        inherent_impl {
                            public_api_eligible @filter(op: "=", value: ["$true"])

                            associated_constant {
                                associated_constant: name @output @tag
                                public_api_eligible @filter(op: "=", value: ["$true"])

                                span_: span @optional {
                                    filename @output
                                    begin_line @output
                                    end_line @output
                                }
                            }
                        }
                    }
                }
            }
            current {
                item {
                    ... on ImplOwner {
                        visibility_limit @filter(op: "=", value: ["$public"])
                        name @output

                        importable_path {
                            path @filter(op: "=", value: ["%path"])
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        inherent_impl @fold @transform(op: "count") @filter(op: "=", value: ["$zero"]) {
                            associated_constant {
                                name @filter(op: "=", value: ["%associated_constant"])

                                # A `pub` constant that gains `#[doc(hidden)]` has its own lint.
                                # Requiring public API eligibility here would also report its removal.
                                visibility_limit @filter(op: "=", value: ["$public"])
                            }
                        }

                        impl @fold @transform(op: "count") @filter(op: "=", value: ["$zero"]) {
                            # We only consider falling back to a trait impl's constant
                            # if the impl of that trait is public API.
                            public_api_eligible @filter(op: "=", value: ["$true"])

                            implemented_trait {
                                trait {
                                    # A private trait cannot provide the constant to downstream callers.
                                    # A glob import can bring a `pub` trait into scope through `pub use Trait as _`,
                                    # which the adapter omits from importable paths. Assume a `pub` trait
                                    # can still provide the constant even if it has no public API path by name.
                                    visibility_limit @filter(op: "=", value: ["$public"])

                                    associated_constant {
                                        name @filter(op: "=", value: ["%associated_constant"])
                                    }
                                }
                            }
                        }

                        # Rustdoc can omit a dependency's trait declaration
                        # while still listing constants defined in the impl.
                        # When we have cross-crate queries, this block won't be necessary.
                        # Rustdoc may inline the trait impl and show the overridden constant there,
                        # which is what this block checks for.
                        #
                        # If `impl Minimum for Limits` defines `MIN`, downstream callers
                        # with the public trait `Minimum` in scope can still use `Limits::MIN`
                        # after the inherent constant becomes private.
                        impl @fold @transform(op: "count") @filter(op: "=", value: ["$zero"]) {
                            public_api_eligible @filter(op: "=", value: ["$true"])

                            # An inherited default appears only in the trait declaration,
                            # so matching it requires the declaration check above.
                            associated_constant {
                                name @filter(op: "=", value: ["%associated_constant"])
                            }

                            implemented_trait {
                                # Require a missing declaration so the visibility check above
                                # governs known traits. An impl of a private trait can also
                                # define a matching constant, which would otherwise hide a removal.
                                trait @fold @transform(op: "count") @filter(op: "=", value: ["$zero"])
                            }
                        }
                    }
                }
            }
        }
    }"#,
    arguments: {
        "public": "public",
        "true": true,
        "zero": 0,
    },
    error_message: "An inherent impl's associated public constant is removed or renamed",
    per_result_error_template: Some("{{name}}::{{associated_constant}}, previously at {{span_filename}}:{{span_begin_line}}"),
)
