SemverQuery(
    id: "inherent_method_now_unwind",
    human_readable_name: "inherent method ABI is now unwind-capable",
    description: "A public inherent method changed from a non-unwind ABI to the same ABI with unwind ability.",
    required_update: Major,
    lint_level: Deny,
    reference_link: Some("https://rust-lang.github.io/rfcs/2945-c-unwind-abi.html"),
    query: r#"
    {
        CrateDiff {
            current {
                item {
                    ... on ImplOwner {
                        visibility_limit @filter(op: "=", value: ["$public"])
                        owner_type: __typename @tag @output
                        name @output

                        importable_path {
                            path @output @tag
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        inherent_impl {
                            # Require both impls to cover every instantiation of their respective owners.
                            # Removing a method on `Reader<u8>` while a same-named method on `Reader<u16>` survives
                            # can look like a change to the removed method's unwind behavior.
                            # TODO: Match restricted impl targets across releases.
                            applies_to_all_owner_instantiations @filter(op: "=", value: ["$true"])

                            method {
                                visibility_limit @filter(op: "=", value: ["$public"])
                                public_api_eligible @filter(op: "=", value: ["$true"])
                                method_name: name @output @tag

                                new_abi_: abi {
                                    unwind @filter(op: "=", value: ["$true"])
                                    name @tag(name: "abi_name")
                                    raw_name @output
                                }

                                span_: span @optional {
                                    filename @output
                                    begin_line @output
                                    end_line @output
                                }
                            }
                        }
                    }
                }
            }
            baseline {
                item {
                    ... on ImplOwner {
                        __typename @filter(op: "=", value: ["%owner_type"])
                        visibility_limit @filter(op: "=", value: ["$public"])

                        importable_path {
                            path @filter(op: "=", value: ["%path"])
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        inherent_impl {
                            applies_to_all_owner_instantiations @filter(op: "=", value: ["$true"])

                            method {
                                visibility_limit @filter(op: "=", value: ["$public"])
                                name @filter(op: "=", value: ["%method_name"])
                                public_api_eligible @filter(op: "=", value: ["$true"])

                                abi_: abi {
                                    name @filter(op: "=", value: ["%abi_name"])
                                    raw_name @output
                                    unwind @filter(op: "=", value: ["$false"])
                                }
                            }
                        }
                    }
                }
            }
        }
    }"#,
    arguments: {
        "public": "public",
        // `unwind` is nullable: `!= true` also accepts unknown values.
        // Use both constants to require known unwind settings.
        "true": true,
        "false": false,
    },
    error_message: "A public inherent method now uses an unwind-capable ABI. Uses of its previous function pointer type may no longer compile.",
    per_result_error_template: Some(r#"{{join "::" path}}::{{method_name}} changed ABI from {{abi_raw_name}} to {{new_abi_raw_name}} in {{span_filename}}:{{span_begin_line}}"#),
)
