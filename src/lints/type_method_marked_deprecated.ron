SemverQuery(
    id: "type_method_marked_deprecated",
    human_readable_name: "type method #[deprecated] added",
    description: "An inherent method has been newly marked with #[deprecated].",
    required_update: Minor,
    lint_level: Deny,
    reference_link: Some("https://doc.rust-lang.org/reference/attributes/diagnostics.html#the-deprecated-attribute"),
    query: r#"
    {
        CrateDiff {
            current {
                item {
                    ... on ImplOwner {
                        visibility_limit @filter(op: "=", value: ["$public"])
                        name @output
                        owner_type: __typename @tag @output

                        importable_path {
                            path @tag @output
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        inherent_impl {
                            # Require both impls to cover every instantiation of their respective owners.
                            # If `Reader<u8>::read` disappears while `Reader<u16>::read` stays deprecated,
                            # matching by name would report that the removed method became deprecated.
                            # TODO: Match restricted impl targets across releases.
                            applies_to_all_owner_instantiations @filter(op: "=", value: ["$true"])

                            public_api_eligible @filter(op: "=", value: ["$true"])

                            method {
                                method_name: name @output @tag
                                public_api_eligible @filter(op: "=", value: ["$true"])
                                deprecated @filter(op: "=", value: ["$true"])

                                span_: span @optional {
                                    filename @output
                                    begin_line @output
                                    end_line @output
                                }
                            }
                        }
                    }
                }
            }
            baseline {
                item {
                    ... on ImplOwner {
                        visibility_limit @filter(op: "=", value: ["$public"])
                        __typename @filter(op: "=", value: ["%owner_type"])

                        importable_path {
                            path @filter(op: "=", value: ["%path"])
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        inherent_impl {
                            applies_to_all_owner_instantiations @filter(op: "=", value: ["$true"])

                            public_api_eligible @filter(op: "=", value: ["$true"])

                            method {
                                name @filter(op: "=", value: ["%method_name"])
                                public_api_eligible @filter(op: "=", value: ["$true"])
                                deprecated @filter(op: "!=", value: ["$true"])
                            }
                        }
                    }
                }
            }
        }
    }"#,
    arguments: {
        "public": "public",
        "true": true,
    },
    error_message: "A type method is now #[deprecated]. Downstream crates will get a compiler warning when using this method.",
    per_result_error_template: Some(r#"method {{join "::" path}}::{{method_name}} in {{span_filename}}:{{span_begin_line}}"#),
)
