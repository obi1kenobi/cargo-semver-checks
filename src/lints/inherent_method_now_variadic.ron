SemverQuery(
    id: "inherent_method_now_variadic",
    human_readable_name: "inherent method has become variadic",
    description: "A public inherent method or associated function is now variadic.",
    required_update: Major,
    lint_level: Deny,
    reference_link: Some(
        "https://doc.rust-lang.org/reference/items/functions.html#c-variadic-functions",
    ),
    query: r#"
    {
        CrateDiff {
            current {
                item {
                    ... on ImplOwner {
                        visibility_limit @filter(op: "=", value: ["$public"])
                        owner_type: __typename @tag
                        owner_crate_id: crate_id @tag

                        importable_path {
                            path @tag @output
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        # Removing a fixed-arity `Reader<u8>::read` can look like it became
                        # variadic if a variadic `Reader<u16>::read` survives. The adapter
                        # cannot distinguish the type arguments of those impls.
                        # TODO: Include generic owners once we can match impl targets.
                        generic_parameter @fold
                                          @transform(op: "count")
                                          @filter(op: "=", value: ["$zero"])

                        # There's a method that is variadic.
                        #
                        # We use `impl` not `inherent_impl` because a method moved to a trait
                        # can still be called through its owner.
                        impl {
                            method {
                                visibility_limit
                                    @filter(op: "one_of", value: ["$public_or_default"])
                                method_name: name @tag @output
                                public_api_eligible @filter(op: "=", value: ["$true"])
                                c_variadic @filter(op: "=", value: ["$true"])

                                span_: span @optional {
                                    filename @output
                                    begin_line @output
                                }
                            }

                            # An inherent impl implements zero traits and a trait impl implements one.
                            # Use that count below to check whether an inherent method shadows a trait method.
                            implemented_trait @fold
                                              @transform(op: "count")
                                              @tag(name: "candidate_trait_count")

                            # Either the trait is defined in another crate (where we assume it's public API),
                            # or it has a public API path in this crate.
                            #
                            # Non-public API traits cannot be used to provide a matching method.
                            implemented_trait @fold
                                              @transform(op: "count")
                                              @filter(op: "=", value: ["$zero"]) {
                                trait {
                                    crate_id @filter(op: "=", value: ["%owner_crate_id"])
                                    importable_path @fold
                                                    @transform(op: "count")
                                                    @filter(op: "=", value: ["$zero"]) {
                                        public_api @filter(op: "=", value: ["$true"])
                                    }
                                }
                            }
                        }

                        # In `Owner::method` lookup, a public inherent method shadows trait methods
                        # with the same name, even when the inherent method is doc-hidden.
                        inherent_impl @fold @transform(op: "count") @filter(op: "=", value: ["$zero"]) {
                            implemented_trait @fold
                                              @transform(op: "count")
                                              @filter(op: "<", value: ["%candidate_trait_count"])

                            method {
                                visibility_limit @filter(op: "=", value: ["$public"])
                                name @filter(op: "=", value: ["%method_name"])
                            }
                        }

                        # If the method wasn't inherent (inherent takes precedence over trait methods;
                        # checked via `candidate_trait_count`), then ensure there's no other trait
                        # that could have offered a matching method with a fixed-arity signature.
                        impl @fold @transform(op: "count") @filter(op: "=", value: ["$zero"]) {
                            implemented_trait @fold
                                              @transform(op: "count")
                                              @filter(op: "=", value: ["%candidate_trait_count"])

                            # Exclude a private trait when its declaration is available.
                            # A glob import can bring a `pub` trait into scope through `pub use Trait as _`,
                            # which the adapter omits from importable paths. Assume a `pub` trait
                            # can preserve the old signature even if it has no public API path by name.
                            implemented_trait @optional {
                                trait @optional {
                                    visibility_limit @filter(op: "=", value: ["$public"])
                                }
                            }

                            method {
                                visibility_limit @filter(op: "one_of", value: ["$public_or_default"])
                                name @filter(op: "=", value: ["%method_name"])
                                public_api_eligible @filter(op: "=", value: ["$true"])
                                c_variadic @filter(op: "!=", value: ["$true"])
                            }
                        }
                    }
                }
            }
            baseline {
                item {
                    ... on ImplOwner {
                        visibility_limit @filter(op: "=", value: ["$public"])
                        __typename @filter(op: "=", value: ["%owner_type"])

                        importable_path {
                            path @filter(op: "=", value: ["%path"])
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        # The baseline owner must also be nongeneric. Its fixed-arity method
                        # could have applied only to one instantiation of the old type.
                        generic_parameter @fold
                                          @transform(op: "count")
                                          @filter(op: "=", value: ["$zero"])

                        # The method was previously inherent and non-variadic.
                        inherent_impl {
                            method {
                                visibility_limit @filter(op: "=", value: ["$public"])
                                name @filter(op: "=", value: ["%method_name"])
                                public_api_eligible @filter(op: "=", value: ["$true"])
                                c_variadic @filter(op: "!=", value: ["$true"])

                                abi_: abi {
                                    raw_name @output
                                }

                                parameter @fold {
                                    name @output(name: "parameter_names")
                                }
                            }
                        }
                    }
                }
            }
        }
    }"#,
    arguments: {
        "public": "public",
        "public_or_default": ["public", "default"],
        "true": true,
        "zero": 0,
    },
    error_message: "A public inherent method or associated function is now variadic. Downstream code relying on its previous signature may no longer compile.",
    per_result_error_template: Some(
        r#"{{join "::" path}}::{{method_name}} in {{span_filename}}:{{span_begin_line}}"#,
    ),
    witness: (
        hint_template: r#"let _: unsafe extern "{{abi_raw_name}}" fn(
{{#each parameter_names}}    _{{#unless @last}},{{/unless}}
{{/each}}) -> _ = {{join "::" path}}::{{method_name}};
"#,
    ),
)
