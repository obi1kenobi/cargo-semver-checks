SemverQuery(
    id: "inherent_method_now_variadic",
    human_readable_name: "inherent method has become variadic",
    description: "A public inherent method or associated function is now variadic.",
    required_update: Major,
    lint_level: Deny,
    reference_link: Some(
        "https://doc.rust-lang.org/reference/items/functions.html#c-variadic-functions",
    ),
    query: r#"
    {
        CrateDiff {
            current {
                item {
                    ... on ImplOwner {
                        visibility_limit @filter(op: "=", value: ["$public"])
                        owner_type: __typename @tag

                        importable_path {
                            path @tag @output
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        # A method moved to a trait can still be called through its owner.
                        impl {
                            # An inherent impl implements zero traits; a trait impl implements one.
                            # Record the candidate's kind so the suppression check below can
                            # respect inherent methods taking precedence over trait methods.
                            implemented_trait @fold
                                              @transform(op: "count")
                                              @tag(name: "candidate_trait_count")

                            method {
                                visibility_limit
                                    @filter(op: "one_of", value: ["$public_or_default"])
                                method_name: name @tag @output
                                public_api_eligible @filter(op: "=", value: ["$true"])
                                c_variadic @filter(op: "=", value: ["$true"])

                                span_: span @optional {
                                    filename @output
                                    begin_line @output
                                }
                            }
                        }

                        # Disjoint generic impls and traits can have methods with the same name.
                        # Do not report a change if a method with the baseline
                        # variadicness still exists: it might be the original method.
                        impl @fold
                             @transform(op: "count")
                             @filter(op: "=", value: ["$zero"]) {
                            # For an inherent candidate (0), only inherent methods can suppress
                            # the report: a trait method cannot preserve an inherent call that
                            # now resolves to a changed signature. For a trait candidate (1),
                            # either kind of method may preserve the baseline API.
                            implemented_trait @fold
                                              @transform(op: "count")
                                              @filter(op: "<=", value: ["%candidate_trait_count"])

                            method {
                                visibility_limit
                                    @filter(op: "one_of", value: ["$public_or_default"])
                                name @filter(op: "=", value: ["%method_name"])
                                public_api_eligible @filter(op: "=", value: ["$true"])
                                c_variadic @filter(op: "!=", value: ["$true"])
                            }
                        }

                        # If an inherent method merely becomes doc-hidden, it still shadows
                        # trait methods. Report that API loss via inherent_method_now_doc_hidden,
                        # without attributing a variadic change to an unrelated trait method.
                        inherent_impl @fold
                                      @transform(op: "count")
                                      @filter(op: "=", value: ["$zero"]) {
                            # An inherent impl's trait count is zero, so this exclusion applies
                            # only to trait candidates (1), never to inherent candidates (0).
                            implemented_trait @fold
                                              @transform(op: "count")
                                              @filter(op: "<", value: ["%candidate_trait_count"])

                            method {
                                visibility_limit @filter(op: "=", value: ["$public"])
                                name @filter(op: "=", value: ["%method_name"])
                                public_api_eligible @filter(op: "!=", value: ["$true"])
                                c_variadic @filter(op: "!=", value: ["$true"])
                            }
                        }
                    }
                }
            }
            baseline {
                item {
                    ... on ImplOwner {
                        visibility_limit @filter(op: "=", value: ["$public"])
                        __typename @filter(op: "=", value: ["%owner_type"])

                        importable_path {
                            path @filter(op: "=", value: ["%path"])
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        inherent_impl {
                            method {
                                visibility_limit @filter(op: "=", value: ["$public"])
                                name @filter(op: "=", value: ["%method_name"])
                                public_api_eligible @filter(op: "=", value: ["$true"])
                                c_variadic @filter(op: "!=", value: ["$true"])

                                abi_: abi {
                                    raw_name @output
                                }

                                parameter @fold {
                                    name @output(name: "parameter_names")
                                }
                            }
                        }
                    }
                }
            }
        }
    }"#,
    arguments: {
        "public": "public",
        "public_or_default": ["public", "default"],
        "true": true,
        "zero": 0,
    },
    error_message: r#"A public inherent method or associated function is now variadic.
Downstream code relying on its previous signature may no longer compile."#,
    per_result_error_template: Some(
        r#"{{join "::" path}}::{{method_name}} in {{span_filename}}:{{span_begin_line}}"#,
    ),
    witness: (
        hint_template: r#"let _: unsafe extern "{{abi_raw_name}}" fn(
{{#each parameter_names}}    _{{#unless @last}},{{/unless}}
{{/each}}) -> _ = {{join "::" path}}::{{method_name}};
"#,
    ),
)
