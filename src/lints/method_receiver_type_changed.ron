SemverQuery(
    id: "method_receiver_type_changed",
    human_readable_name: "method receiver changed type",
    description: "A method's receiver is a different type than before.",
    required_update: Major,
    lint_level: Deny,
    reference_link: Some("https://doc.rust-lang.org/reference/items/associated-items.html#methods"),
    query: r#"
    {
        CrateDiff {
            baseline {
                item {
                    ... on ImplOwner {
                        visibility_limit @filter(op: "=", value: ["$public"])
                        owner_type: __typename @tag @output
                        name @output

                        importable_path {
                            path @tag @output
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        inherent_impl {
                            method {
                                visibility_limit @filter(op: "=", value: ["$public"])
                                public_api_eligible @filter(op: "=", value: ["$true"])
                                method_name: name @output @tag

                                baseline_receiver_: receiver {
                                    by_reference @output
                                    by_mut_reference @output
                                    by_value @output
                                    kind @tag(name: "receiver_kind") @output
                                }

                                span_: span @optional {
                                    filename @output
                                    begin_line @output
                                    end_line @output
                                }
                            }
                        }
                    }
                }
            }
            current {
                item {
                    ... on ImplOwner {
                        __typename @filter(op: "=", value: ["%owner_type"])
                        visibility_limit @filter(op: "=", value: ["$public"])

                        importable_path {
                            path @filter(op: "=", value: ["%path"])
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        generic_parameter @fold
                                          @transform(op: "count")
                                          @tag(name: "owner_generic_count")

                        # A `Reader<bool>::get` may move to a trait that preserves its calls while
                        # an unrelated inherent `Reader<u8>::get` remains. Without impl targets,
                        # we could mistake this for a receiver change to `Reader<bool>::get`.
                        #
                        # Conservatively, we include trait alternatives for generic owners.
                        # For a nongeneric owner, moving `get` entirely to a trait leaves no
                        # inherent candidate below; a remaining inherent `get` is unambiguous.
                        # Include private and doc-hidden methods too: the original method
                        # may have changed only its visibility, not its receiver.
                        impl @fold @transform(op: "count") @tag(name: "candidate_count") {
                            # Zero for inherent impls, one for trait impls: this admits traits
                            # only when the owner has at least one generic parameter.
                            implemented_trait @fold
                                              @transform(op: "count")
                                              @filter(op: "<=", value: ["%owner_generic_count"])

                            method {
                                name @filter(op: "=", value: ["%method_name"])
                            }
                        }

                        # Compare receiver types after removing any outer `&` or `&mut`.
                        # Report an old method only if
                        # at least one same-named inherent method exists in the new version,
                        # all such methods are public API, and every receiver type differs from the old method's.
                        # The current types may differ from each other, and some methods may be unchanged.
                        # Retaining the old type in any impl suppresses the report,
                        # even if a method in another impl changed its type.
                        #
                        # For a type with generic parameters,
                        # any current trait impl with a function of this name also suppresses the report,
                        # even if that function could not preserve calls to the old method.
                        # This deliberately accepts missed receiver changes
                        # to avoid misreporting an inherent method's move to a trait.
                        #
                        # TODO: Match impl targets to detect changes with mixed candidates.
                        inherent_impl @fold
                                      @transform(op: "count")
                                      @filter(op: ">", value: ["$zero"])
                                      @filter(op: "=", value: ["%candidate_count"]) {
                            method {
                                visibility_limit @filter(op: "=", value: ["$public"])
                                name @filter(op: "=", value: ["%method_name"])
                                public_api_eligible @filter(op: "=", value: ["$true"])

                                receiver {
                                    kind @filter(op: "!=", value: ["%receiver_kind"])
                                }
                            }
                        }
                    }
                }
            }
        }
    }"#,
    arguments: {
        "public": "public",
        "true": true,
        "zero": 0,
    },
    error_message: "A method no longer accepts its previous receiver type.",
    per_result_error_template: Some("{{join \"::\" path}}::{{method_name}} no longer accepts {{#if baseline_receiver_by_reference }}&{{/if}}{{#if baseline_receiver_by_mut_reference }}&mut {{/if}}{{baseline_receiver_kind}}; previously in {{span_filename}}:{{span_begin_line}}"),
    witness: None,
)
