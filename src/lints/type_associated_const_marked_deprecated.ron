SemverQuery(
    id: "type_associated_const_marked_deprecated",
    human_readable_name: "type's associated constant #[deprecated] added",
    description: "An inherent associated constant has been newly marked with #[deprecated].",
    required_update: Minor,
    lint_level: Deny,
    reference_link: Some("https://doc.rust-lang.org/reference/attributes/diagnostics.html#the-deprecated-attribute"),
    query: r#"
    {
        CrateDiff {
            current {
                item {
                    ... on ImplOwner {
                        visibility_limit @filter(op: "=", value: ["$public"])
                        name @output
                        owner_type: __typename @tag @output

                        importable_path {
                            path @tag @output
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        # The adapter cannot distinguish `impl Reader<u8>` from `impl Reader<u16>`.
                        # If `Reader<u8>::MAX` disappears while `Reader<u16>::MAX` stays deprecated,
                        # matching by name would report that the removed constant became deprecated.
                        # TODO: Include generic owners once we can match impl targets.
                        generic_parameter @fold
                                          @transform(op: "count")
                                          @filter(op: "=", value: ["$zero"])

                        inherent_impl {
                            public_api_eligible @filter(op: "=", value: ["$true"])

                            associated_constant {
                                associated_constant: name @output @tag
                                public_api_eligible @filter(op: "=", value: ["$true"])
                                deprecated @filter(op: "=", value: ["$true"])

                                span_: span @optional {
                                    filename @output
                                    begin_line @output
                                    end_line @output
                                }
                            }
                        }
                    }
                }
            }
            baseline {
                item {
                    ... on ImplOwner {
                        visibility_limit @filter(op: "=", value: ["$public"])
                        __typename @filter(op: "=", value: ["%owner_type"])

                        importable_path {
                            path @filter(op: "=", value: ["%path"])
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        # The baseline owner must also be nongeneric. Removing its generic parameters
                        # can eliminate the instantiation that provided the old constant.
                        generic_parameter @fold
                                          @transform(op: "count")
                                          @filter(op: "=", value: ["$zero"])

                        inherent_impl {
                            public_api_eligible @filter(op: "=", value: ["$true"])

                            associated_constant {
                                name @filter(op: "=", value: ["%associated_constant"])
                                public_api_eligible @filter(op: "=", value: ["$true"])
                                deprecated @filter(op: "!=", value: ["$true"])
                            }
                        }
                    }
                }
            }
        }
    }"#,
    arguments: {
        "public": "public",
        "true": true,
        "zero": 0,
    },
    error_message: "A type's associated constant is now #[deprecated]. Downstream crates will get a compiler warning when using it.",
    per_result_error_template: Some(r#"associated constant {{join "::" path}}::{{associated_constant}} in {{span_filename}}:{{span_begin_line}}"#),
)
