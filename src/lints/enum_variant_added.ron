SemverQuery(
    id: "enum_variant_added",
    human_readable_name: "enum variant added on exhaustive enum",
    description: "An exhaustive enum has a new variant.",
    required_update: Major,
    lint_level: Deny,
    reference_link: Some("https://doc.rust-lang.org/cargo/reference/semver.html#enum-variant-new"),
    query: r#"
    {
        CrateDiff {
            current {
                item {
                    ... on Enum {
                        enum_name: name @output
                        visibility_limit @filter(op: "=", value: ["$public"]) @output

                        importable_path {
                            path @output @tag
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        variant {
                            variant_name: name @output @tag

                            span_: span @optional {
                                filename @output
                                begin_line @output
                                end_line @output
                            }
                        }
                    }
                }
            }
            baseline {
                item {
                    ... on Enum {
                        visibility_limit @filter(op: "=", value: ["$public"])
                        # Baseline exhaustiveness makes a new variant a major change,
                        # even if the enum also becomes #[non_exhaustive].
                        attrs @filter(op: "not_contains", value: ["$non_exhaustive"])

                        importable_path {
                            path @filter(op: "=", value: ["%path"])
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        variant @fold @transform(op: "count") @filter(op: "=", value: ["$zero"]) {
                            name @filter(op: "=", value: ["%variant_name"])
                        }

                        variant @fold {
                            baseline_variant_kinds: __typename @output

                            baseline_variant_names: name @output

                            attribute @fold @transform(op: "count") @output(name: "baseline_non_exhaustive") {
                                raw_attribute @filter(op: "=", value: ["$non_exhaustive"])
                            }
                        }
                    }
                }
            }
        }
    }"#,
    arguments: {
        "public": "public",
        "true": true,
        "zero": 0,
        "non_exhaustive": "#[non_exhaustive]",
    },
    error_message: "A publicly-visible enum without #[non_exhaustive] has a new variant.",
    per_result_error_template: Some("variant {{enum_name}}:{{variant_name}} in {{span_filename}}:{{span_begin_line}}"),
    witness: (
        // #[non_exhaustive] unit and tuple variants have private constructors, so their
        // bare unit and tuple patterns fail even against the baseline.
        // Struct-style syntax works for tuple variants regardless of exhaustiveness.
        hint_template: r#"match value {
{{#each baseline_variant_kinds }}
    {{ join "::" ../path }}::{{lookup ../baseline_variant_names @index}}{{#if (lookup ../baseline_non_exhaustive @index)}} { .. }{{else}}{{#if (eq this "StructVariant")}} { .. }{{/if}}{{#if (eq this "TupleVariant")}}(..){{/if}}{{/if}} => (),
{{/each}}
}
"#,
    ),
)
