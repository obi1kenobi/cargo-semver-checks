SemverQuery(
    id: "sealed_trait_associated_const_added",
    human_readable_name: "sealed trait added associated constant",
    description: "A sealed public trait added a new associated constant. This is not a breaking change since downstream crates couldn't have implemented the sealed trait.",
    required_update: Minor,
    lint_level: Allow,
    reference_link: Some("https://rust-lang.github.io/api-guidelines/future-proofing.html#sealed-traits-protect-against-downstream-implementations-c-sealed"),
    query: r#"
    {
        CrateDiff {
            current {
                item {
                    ... on Trait {
                        visibility_limit @filter(op: "=", value: ["$public"])

                        importable_path {
                            path @output @tag
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        associated_constant {
                            associated_constant: name @output @tag
                            public_api_eligible @filter(op: "=", value: ["$true"])

                            span_: span @optional {
                                filename @output
                                begin_line @output
                                end_line @output
                            }
                        }
                    }
                }
            }
            baseline {
                item {
                    ... on Trait {
                        visibility_limit @filter(op: "=", value: ["$public"]) @output
                        # If the baseline trait wasn't sealed, downstream crates may have implemented it,
                        # and `trait_associated_const_added` reports constants without a default value.
                        public_api_sealed @filter(op: "=", value: ["$true"])
                        # If the baseline trait was dyn-compatible, the new associated constant makes it
                        # no longer dyn-compatible, which `trait_no_longer_dyn_compatible` reports instead.
                        dyn_compatible @filter(op: "!=", value: ["$true"])

                        importable_path {
                            path @filter(op: "=", value: ["%path"])
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        associated_constant @fold @transform(op: "count") @filter(op: "=", value: ["$zero"]) {
                            name @filter(op: "=", value: ["%associated_constant"])
                        }
                    }
                }
            }
        }
    }"#,
    arguments: {
        "public": "public",
        "true": true,
        "zero": 0,
    },
    error_message: "A sealed public trait added a new associated constant.",
    per_result_error_template: Some("trait constant {{join \"::\" path}}::{{associated_constant}} in file {{span_filename}}:{{span_begin_line}}"),
)
