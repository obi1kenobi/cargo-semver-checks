SemverQuery(
    id: "inherent_method_changed_abi",
    human_readable_name: "inherent method changed ABI",
    description: "A public inherent method changed its external ABI.",
    required_update: Major,
    lint_level: Deny,
    reference_link: Some("https://doc.rust-lang.org/reference/items/external-blocks.html#abi"),
    query: r#"
    {
        CrateDiff {
            baseline {
                item {
                    ... on ImplOwner {
                        visibility_limit @filter(op: "=", value: ["$public"])
                        owner_type: __typename @tag @output
                        name @output

                        importable_path {
                            path @tag @output
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        # The adapter cannot distinguish `impl Reader<u8>` from `impl Reader<u16>`.
                        # Removing a method on one while a same-named method on the other survives
                        # can look like a change to the removed method's ABI.
                        # TODO: Include generic owners once we can match impl targets.
                        generic_parameter @fold
                                          @transform(op: "count")
                                          @filter(op: "=", value: ["$zero"])

                        inherent_impl {
                            method {
                                visibility_limit @filter(op: "=", value: ["$public"])
                                public_api_eligible @filter(op: "=", value: ["$true"])
                                method_name: name @output @tag

                                baseline_abi_: abi {
                                    name @tag(name: "abi_name") @output
                                    raw_name @output
                                }
                            }
                        }
                    }
                }
            }
            current {
                item {
                    ... on ImplOwner {
                        __typename @filter(op: "=", value: ["%owner_type"])
                        visibility_limit @filter(op: "=", value: ["$public"])

                        importable_path {
                            path @filter(op: "=", value: ["%path"])
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        # A current method could exist only on a new parameterization of the owner.
                        generic_parameter @fold
                                          @transform(op: "count")
                                          @filter(op: "=", value: ["$zero"])

                        inherent_impl {
                            method {
                                visibility_limit @filter(op: "=", value: ["$public"])
                                name @filter(op: "=", value: ["%method_name"])
                                public_api_eligible @filter(op: "=", value: ["$true"])

                                new_abi_: abi {
                                    name @filter(op: "!=", value: ["%abi_name"]) @output
                                    raw_name @output
                                }

                                span_: span @optional {
                                    filename @output
                                    begin_line @output
                                    end_line @output
                                }
                            }
                        }
                    }
                }
            }
        }
    }"#,
    arguments: {
        "public": "public",
        "true": true,
        "zero": 0,
    },
    error_message: "An inherent method changed its ABI. Uses of its previous function pointer type may no longer compile.",
    per_result_error_template: Some(r#"{{join "::" path}}::{{method_name}} changed from {{baseline_abi_raw_name}} to {{new_abi_raw_name}} in {{span_filename}}:{{span_begin_line}}"#),
    // Idea for what the witness looks like:
    // https://github.com/obi1kenobi/cargo-semver-checks/issues/1281
    witness: None,
)
