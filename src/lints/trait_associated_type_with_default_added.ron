SemverQuery(
    id: "trait_associated_type_with_default_added",
    human_readable_name: "non-sealed trait added associated type with default value",
    description: "A non-sealed public trait added a new associated type with a default value.",
    required_update: Minor,
    lint_level: Allow,
    reference_link: Some("https://doc.rust-lang.org/cargo/reference/semver.html#trait-new-default-item"),
    query: r#"
    {
        CrateDiff {
            current {
                item {
                    ... on Trait {
                        visibility_limit @filter(op: "=", value: ["$public"])

                        importable_path {
                            path @output @tag
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        associated_type {
                            associated_type: name @output @tag
                            # Types without a default value are reported by `trait_associated_type_added`.
                            has_default @filter(op: "=", value: ["$true"])
                            public_api_eligible @filter(op: "=", value: ["$true"])

                            span_: span @optional {
                                filename @output
                                begin_line @output
                                end_line @output
                            }
                        }
                    }
                }
            }
            baseline {
                item {
                    ... on Trait {
                        visibility_limit @filter(op: "=", value: ["$public"]) @output
                        # If the baseline trait was sealed, downstream crates couldn't implement it,
                        # so whether the new type has a default value makes no difference to them.
                        public_api_sealed @filter(op: "!=", value: ["$true"])
                        # This lint doesn't check dyn-compatibility: if the new type makes the trait
                        # no longer dyn-compatible, `trait_no_longer_dyn_compatible` reports that too.

                        importable_path {
                            path @filter(op: "=", value: ["%path"])
                            public_api @filter(op: "=", value: ["$true"])
                        }

                        associated_type @fold @transform(op: "count") @filter(op: "=", value: ["$zero"]) {
                            name @filter(op: "=", value: ["%associated_type"])
                        }
                    }
                }
            }
        }
    }"#,
    arguments: {
        "public": "public",
        "true": true,
        "zero": 0,
    },
    error_message: "A non-sealed public trait added a new associated type with a default value.",
    per_result_error_template: Some(r#"{{join "::" path}}::{{associated_type}} in file {{span_filename}}:{{span_begin_line}}"#),
)
